<?xml version="1.0"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <!--
    Production transform for MonsterASP.
    IMPORTANT: replace __DB_PASSWORD__ only in the local/published copy before deployment.
    Never commit the real database password to GitHub.
  -->
  <connectionStrings>
    <add name="CSMMYMEntities"
         connectionString="metadata=res://*/Models.CSMMYM.csdl|res://*/Models.CSMMYM.ssdl|res://*/Models.CSMMYM.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=db68708.databaseasp.net,1433;initial catalog=db68708;user id=db68708;password=__DB_PASSWORD__;trustservercertificate=True;MultipleActiveResultSets=True;App=EntityFramework&quot;"
         providerName="System.Data.EntityClient"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(name)" />
  </connectionStrings>

  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <customErrors mode="RemoteOnly" xdt:Transform="SetAttributes" />
    <authentication mode="Forms">
      <forms requireSSL="true" xdt:Transform="SetAttributes" />
    </authentication>
  </system.web>
</configuration>
