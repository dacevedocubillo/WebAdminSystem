@using CSMMYM.Models
@{
    ViewBag.Title = "Panel administrativo";
    Layout = "~/Views/Shared/_Layout.cshtml";

    PermisosUsuario permisos = null;
    if (Session["id_usuario"] is int idUsuario && PermisosPorUsuario.Lista.ContainsKey(idUsuario))
    {
        permisos = PermisosPorUsuario.Lista[idUsuario];
    }
}

<section class="admin-dashboard py-4">
    <div class="admin-hero mb-4">
        <div>
            <span class="admin-eyebrow">WEB ADMIN SYSTEM</span>
            <h1>Panel administrativo</h1>
            <p>Bienvenida, <strong>@Session["Usuario"]</strong>. Gestiona el contenido y las operaciones principales desde un solo lugar.</p>
        </div>
        <a class="btn btn-light admin-site-link" href="@Url.Action("Index", "Home")">Ver sitio público <span aria-hidden="true">↗</span></a>
    </div>

    <div class="admin-section-heading">
        <div><span>GESTIÓN</span><h2>Accesos rápidos</h2></div>
        <p>Herramientas disponibles según los permisos de tu sesión.</p>
    </div>

    <div class="row g-4">
        @if (permisos != null && permisos.AccesoProductos)
        {
            <div class="col-md-6 col-xl-4">
                <a class="admin-card" href="@Url.Action("ListaProductos", "Productos")">
                    <span class="admin-card-icon"><i class="fas fa-box"></i></span>
                    <span class="admin-card-copy"><strong>Productos</strong><small>Catálogo, precios, imágenes y estado.</small></span>
                    <span class="admin-card-arrow">→</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="admin-card" href="@Url.Action("ListaServicios", "Servicios")">
                    <span class="admin-card-icon"><i class="fas fa-screwdriver-wrench"></i></span>
                    <span class="admin-card-copy"><strong>Servicios</strong><small>Servicios, categorías y precios base.</small></span>
                    <span class="admin-card-arrow">→</span>
                </a>
            </div>
        }

        <div class="col-md-6 col-xl-4">
            <a class="admin-card" href="@Url.Action("ListaContacto", "Contacto")">
                <span class="admin-card-icon"><i class="fas fa-envelope"></i></span>
                <span class="admin-card-copy"><strong>Contactos</strong><small>Solicitudes y mensajes recibidos.</small></span>
                <span class="admin-card-arrow">→</span>
            </a>
        </div>

        @if (permisos != null && permisos.AccesoUsuarios)
        {
            <div class="col-md-6 col-xl-4">
                <a class="admin-card" href="@Url.Action("ListaUsuarios", "Usuario")">
                    <span class="admin-card-icon"><i class="fas fa-users"></i></span>
                    <span class="admin-card-copy"><strong>Usuarios</strong><small>Cuentas, roles, estado y permisos.</small></span>
                    <span class="admin-card-arrow">→</span>
                </a>
            </div>
        }

        @if (permisos != null && permisos.AccesoReportes)
        {
            <div class="col-md-6 col-xl-4">
                <a class="admin-card" href="@Url.Action("ReporteProductos", "Reportes")">
                    <span class="admin-card-icon"><i class="fas fa-chart-column"></i></span>
                    <span class="admin-card-copy"><strong>Reporte de productos</strong><small>Consulta información del catálogo.</small></span>
                    <span class="admin-card-arrow">→</span>
                </a>
            </div>
            <div class="col-md-6 col-xl-4">
                <a class="admin-card" href="@Url.Action("ReporteServicios", "Reportes")">
                    <span class="admin-card-icon"><i class="fas fa-file-lines"></i></span>
                    <span class="admin-card-copy"><strong>Reporte de servicios</strong><small>Consulta información de servicios.</small></span>
                    <span class="admin-card-arrow">→</span>
                </a>
            </div>
        }
    </div>
</section>

<style>
    .admin-dashboard{max-width:1180px;margin:auto}.admin-hero{display:flex;justify-content:space-between;align-items:center;gap:2rem;padding:2.4rem;border-radius:28px;background:linear-gradient(135deg,#15233b,#234c6f);color:#fff;box-shadow:0 24px 60px rgba(21,35,59,.18)}.admin-eyebrow{font-size:.72rem;font-weight:800;letter-spacing:.18em;opacity:.72}.admin-hero h1{font-size:clamp(2rem,4vw,3.25rem);margin:.4rem 0 .6rem;font-weight:800}.admin-hero p{max-width:680px;margin:0;color:rgba(255,255,255,.78);font-size:1.02rem}.admin-site-link{white-space:nowrap;border-radius:999px;font-weight:700;padding:.8rem 1.15rem}.admin-section-heading{display:flex;justify-content:space-between;align-items:end;gap:2rem;margin:2.8rem 0 1.2rem}.admin-section-heading span{font-size:.72rem;font-weight:800;letter-spacing:.16em;color:#52728d}.admin-section-heading h2{font-size:1.65rem;margin:.25rem 0 0;font-weight:800;color:#15233b}.admin-section-heading p{margin:0;color:#6b7c8d}.admin-card{height:100%;min-height:145px;display:flex;align-items:center;gap:1rem;padding:1.5rem;border:1px solid #e2e9ef;border-radius:22px;background:#fff;color:#15233b;text-decoration:none;box-shadow:0 12px 32px rgba(21,35,59,.07);transition:.2s ease}.admin-card:hover{color:#15233b;transform:translateY(-4px);box-shadow:0 18px 42px rgba(21,35,59,.12);border-color:#b9cbd9}.admin-card-icon{width:52px;height:52px;flex:0 0 52px;border-radius:16px;display:grid;place-items:center;background:#edf4f8;color:#315f7d;font-size:1.2rem}.admin-card-copy{display:flex;flex-direction:column;gap:.3rem;min-width:0}.admin-card-copy strong{font-size:1.05rem}.admin-card-copy small{color:#718190;line-height:1.5}.admin-card-arrow{margin-left:auto;font-size:1.4rem;color:#7892a5}@media(max-width:767px){.admin-hero,.admin-section-heading{align-items:flex-start;flex-direction:column}.admin-hero{padding:1.7rem}.admin-site-link{width:100%;text-align:center}.admin-section-heading{gap:.5rem}}
</style>
