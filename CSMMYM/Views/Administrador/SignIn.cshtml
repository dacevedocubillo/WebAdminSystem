@{
    ViewBag.Title = "Administrador | Iniciar Sesión";
    Layout = null; // login suele ir sin layout global
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
</head>

<body class="bg-dark d-flex align-items-center justify-content-center vh-100">

    <div class="card shadow-lg border-0" style="width: 380px;">
        <!-- Encabezado -->
        <div class="card-header bg-danger text-white text-center">
            <i class="fas fa-user-shield fa-2x mb-2"></i>
            <h4 class="mb-0">Administrador</h4>
        </div>

        <!-- Cuerpo -->
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <div class="alert alert-danger text-center">
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm("SignIn", "Administrador", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <input type="text" name="username" class="form-control" placeholder="Usuario" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" name="password" class="form-control" placeholder="Contraseña" required />
                </div>

                <button type="submit" class="btn btn-danger w-100">
                    <i class="fas fa-sign-in-alt"></i> Ingresar
                </button>
            }
        </div>

        <!-- Pie -->
        <div class="card-footer text-center small text-muted">
            Acceso exclusivo para administradores
        </div>
    </div>

</body>
</html>