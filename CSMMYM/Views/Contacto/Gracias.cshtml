@{
    ViewBag.Title = "Gracias";
    Layout = null;
}

<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- FontAwesome CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="alert alert-success shadow-lg text-center p-4 rounded-3 animate__animated animate__fadeIn">
        <i class="fas fa-check-circle fa-3x mb-3"></i>
        <h3 class="fw-bold">¡Gracias por contactarnos!</h3>
        <p class="mb-0">Tu mensaje ha sido enviado correctamente.<br />Nos pondremos en contacto contigo pronto.</p>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- Animación con Animate.css (opcional) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet">

<!-- CSS personalizado -->
<style>
    .alert-success {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: #fff;
        border: none;
    }

        .alert-success h3 {
            color: #fff;
        }

        .alert-success p {
            color: #f8f9fa;
        }
</style>