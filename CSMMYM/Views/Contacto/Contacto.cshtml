@model CSMMYM.Models.FormularioContacto

@{
    ViewBag.Title = "Formulario de Contacto";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}


<link rel="stylesheet" href="~/Content/bootstrap.css" />
<link rel="stylesheet" href="~/Content/css/site-user.css" />


<div class="contact-form mt-4">
    @using (Html.BeginForm("Enviar", "Contacto", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @* Validation summary *@
        @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

        <div class="form-group">
            <label for="Nombre">Nombre</label>
            @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control", placeholder = "Tu nombre completo" })
            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "field-validation-error" })
        </div>

        <div class="form-group">
            <label for="Correo">Correo</label>
            @Html.TextBoxFor(m => m.Correo, new { @class = "form-control", type = "email", placeholder = "tu@correo.com" })
            @Html.ValidationMessageFor(m => m.Correo, "", new { @class = "field-validation-error" })
            <small class="help-text">Usá un correo válido para que podamos responderte.</small>
        </div>

        <div class="form-group">
            <label for="Mensaje">Mensaje</label>
            @Html.TextAreaFor(m => m.Mensaje, new { @class = "form-control", placeholder = "Escribí tu consulta..." })
            @Html.ValidationMessageFor(m => m.Mensaje, "", new { @class = "field-validation-error" })
        </div>

        <div class="text-center mt-3">
            <button type="submit" class="btn btn-submit">Enviar</button>
        </div>
    }
</div>