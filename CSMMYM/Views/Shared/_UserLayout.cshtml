

@{
    ViewBag.Title = "Index";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Montacargas y +</title>

    <!-- Bootstrap -->
    <link rel="stylesheet" href="~/Content/bootstrap.css" />

    <!-- Favicon en PNG -->
    <link rel="icon" type="image/png" href="~/Content/Imagenes/favicon.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="~/Content/Imagenes/favicon.png" sizes="64x64" />

    <!-- Estilos generales -->
    <link rel="stylesheet" href="~/Content/site-user.css" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        main {
            flex: 1; /* 🔥 ESTA ES LA CLAVE */
        }

        footer {
            background: #f8f9fa;
            padding: 15px 0;
            text-align: center;
        }
    </style>

</head>
<body>
    <!-- Barra de navegación -->
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">

            <!-- Logo + nombre -->
            <a class="navbar-brand d-flex align-items-center" href="@Url.Action("Index","Home")">
                <img src="~/Content/Imagenes/icon.png" alt="CSSMY" style="height:60px;" class="me-2" />
            </a>

            <!-- Botón responsive -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Menú -->
            <div class="collapse navbar-collapse" id="menuPrincipal">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">@Html.ActionLink("Inicio", "Index", "Home", null, new { @class = "nav-link" })</li>
                    <li class="nav-item">@Html.ActionLink("Quiénes somos", "QuienesSomos", "QuienesSomos", null, new { @class = "nav-link" })</li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="productosMenu" role="button" data-bs-toggle="dropdown">Productos</a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Montacargas Eléctricos", "Electrico", "Productos", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Montacargas Diésel", "Diesel", "Productos", null, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="serviciosMenu" role="button" data-bs-toggle="dropdown">Servicios</a>
                        <ul class="dropdown-menu">
                            <li>@Html.ActionLink("Mantenimiento", "Mantenimiento", "Servicios", null, new { @class = "dropdown-item" })</li>
                            <li>@Html.ActionLink("Alquiler", "Alquiler", "Servicios", null, new { @class = "dropdown-item" })</li>
                        </ul>
                    </li>
                    <li class="nav-item">@Html.ActionLink("Contacto", "Contacto", "Contacto", null, new { @class = "nav-link" })</li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <!-- Footer global -->
    <footer>
        <div class="container footer-container">
            <!-- contenido -->
        </div>
        <div class="container footer-bottom">
            <p>&copy; @DateTime.Now.Year - Montacargas y +</p>
            <p>Tel: +506 2222-2222 | Email: info@cssmy.com</p>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="~/Scripts/bootstrap.bundle.js"></script>
</body>
</html>

