@{
    ViewBag.Title = "Manual de Usuario";
}

<h2 class="mb-4">
    <i class="fas fa-book me-2 text-primary"></i> Manual de Usuario
</h2>

<div class="card shadow-sm border-0 rounded-3">
    <div class="card-body text-center">
        <p class="lead text-muted">
            Descarga el manual de usuario oficial del sistema <strong>CSSMY – Sistema de Gestión</strong>.
            Incluye instrucciones, capturas de pantalla y ejemplos prácticos para facilitar el uso.
        </p>

        <a href="@Url.Action("DescargarManualUsuarioPDF","Ayuda")"
           class="btn btn-success px-4 py-2 shadow-sm btn-download">
            <i class="fas fa-file-pdf me-2"></i> Descargar Manual en PDF
        </a>
    </div>
</div>

<!-- FontAwesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<!-- CSS personalizado -->
<style>
    h2 {
        font-weight: 700;
        color: #343a40;
        border-bottom: 3px solid #007bff;
        display: inline-block;
        padding-bottom: 0.3rem;
    }

    .card {
        max-width: 700px;
        margin: auto;
    }

    .btn-download {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        font-weight: 600;
        border-radius: 30px;
        transition: all 0.3s ease;
    }

        .btn-download:hover {
            background: linear-gradient(135deg, #20c997, #28a745);
            transform: translateY(-2px);
        }
</style>