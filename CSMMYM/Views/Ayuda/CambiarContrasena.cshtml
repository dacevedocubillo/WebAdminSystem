@{
    ViewBag.Title = "Cambiar Contraseña";
}

<h2 class="mb-4">
    <i class="fas fa-lock me-2 text-primary"></i> Cambiar Contraseña
</h2>

<!-- Mensajes -->
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger shadow-sm rounded-3">
        <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.Error
    </div>
}

@if (ViewBag.Exito != null)
{
    <div class="alert alert-success shadow-sm rounded-3">
        <i class="fas fa-check-circle me-2"></i> @ViewBag.Exito
    </div>
}

<!-- FORMULARIO -->
<form method="post" action="/Ayuda/CambiarContrasena" class="card shadow-sm p-4 rounded-3">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="fw-semibold"><i class="fas fa-key me-2 text-secondary"></i> Contraseña Actual</label>
        <input type="password" name="actual" class="form-control" placeholder="Ingresa tu contraseña actual" required />
    </div>

    <div class="mb-3">
        <label class="fw-semibold"><i class="fas fa-lock-open me-2 text-secondary"></i> Nueva Contraseña</label>
        <input type="password" name="nueva" class="form-control" placeholder="Ingresa tu nueva contraseña" required />
    </div>

    <div class="mb-3">
        <label class="fw-semibold"><i class="fas fa-check-double me-2 text-secondary"></i> Confirmar Contraseña</label>
        <input type="password" name="confirmar" class="form-control" placeholder="Repite tu nueva contraseña" required />
    </div>

    <div class="text-end mt-4">
        <button type="submit" class="btn btn-success px-4 py-2 shadow-sm btn-save">
            <i class="fas fa-sync-alt me-2"></i> Cambiar Contraseña
        </button>
        <a href="@Url.Action("PanelAdmin", "Administrador")"
           class="btn btn-secondary px-4 py-2 shadow-sm ms-2">
            <i class="fas fa-arrow-left me-2"></i> Cancelar
        </a>
    </div>
</form>

<!-- FontAwesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<!-- CSS personalizado -->
<style>
    h2 {
        font-weight: 700;
        color: #343a40;
        border-bottom: 3px solid #007bff;
        display: inline-block;
        padding-bottom: 0.3rem;
    }

    .card {
        border: none;
        background: #ffffff;
    }

    .form-control {
        border-radius: 8px;
        transition: box-shadow 0.2s ease;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(0,123,255,0.25);
            border-color: #007bff;
        }

    .btn-save {
        background: linear-gradient(135deg, #28a745, #20c997);
        border: none;
        font-weight: 600;
        border-radius: 30px;
        transition: all 0.3s ease;
    }

        .btn-save:hover {
            background: linear-gradient(135deg, #20c997, #28a745);
            transform: translateY(-2px);
        }

    .btn-secondary {
        border-radius: 30px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #6c757d;
            color: #fff;
            transform: translateY(-2px);
        }

    .alert {
        font-weight: 500;
    }
</style>