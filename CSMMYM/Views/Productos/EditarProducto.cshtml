@model CSMMYM.Models.RetornaProducto_ID_Result

@{
    ViewBag.Title = "EditarProducto";
}

<h2>✏️ Editar Producto</h2>

@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@if (ViewBag.MensajeError != null)
{
    <div class="alert alert-danger">
        @ViewBag.MensajeError
    </div>
}

@using (Html.BeginForm("EditarProducto", "Productos", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.id_producto)

    <!-- NOMBRE -->
    <div class="form-group mb-3">
        @Html.LabelFor(m => m.nombre)
        @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", placeholder = "Nombre del producto" })
    </div>

    <!-- TIPO -->
    <div class="form-group mb-3">
        @Html.LabelFor(m => m.tipo, "Tipo de Montacargas")
        @Html.DropDownListFor(m => m.tipo, new SelectList(new[] {
            "Eléctrico", "Diésel"
        }, Model.tipo), "Seleccione un tipo", new { @class = "form-control" })
    </div>

    <!-- PRECIO -->
    <div class="form-group mb-3">
        @Html.LabelFor(m => m.precio)
        @Html.TextBoxFor(m => m.precio, new { @class = "form-control", type = "number", step = "0.01" })
    </div>

    <!-- DESCRIPCIÓN -->
    <div class="form-group mb-3">
        @Html.LabelFor(m => m.descripcion)
        @Html.TextAreaFor(m => m.descripcion, new { @class = "form-control", rows = 3 })
    </div>

    <!-- IMAGEN -->
    <div class="form-group mb-3">
        <label>Imagen actual</label><br />
        @if (!string.IsNullOrEmpty(Model.imagen))
        {
            <img src="~/Content/Imagenes/@Model.imagen" alt="Foto actual" class="img-thumbnail mb-2" style="max-width:150px;" />
        }
        else
        {
            <span class="text-muted">Sin imagen</span>
        }

        <br />
        <label for="imagen">Cambiar imagen</label>
        <input type="file" name="imagen" class="form-control" />
    </div>

    <hr />

    <button type="submit" class="btn btn-success">
        💾 Guardar cambios
    </button>

    @Html.ActionLink("Volver a la lista", "ListaProductos", "Productos",
            null, new { @class = "btn btn-secondary ms-2" })
}