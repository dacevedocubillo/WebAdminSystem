@model CSMMYM.Models.Cotizacion

@{
    ViewBag.Title = "Crear Cotización";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string hiddenIdContacto = "";
    if (ViewBag.IdContacto != null)
    {
        hiddenIdContacto = $"<input type='hidden' name='idContacto' value='{ViewBag.IdContacto}' />";
    }
}

<h2>Crear Cotización</h2>

@using (Html.BeginForm("Crear", "Cotizacion", FormMethod.Post))
{
    @Html.Raw(hiddenIdContacto)

    <div class="form-group">
        @Html.LabelFor(m => m.nombre, "Nombre del Cliente")
        @Html.TextBoxFor(m => m.nombre, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.correo, "Correo")
        @Html.TextBoxFor(m => m.correo, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.detalle, "Descripción General")
        @Html.TextAreaFor(m => m.detalle, new { @class = "form-control", rows = 4 })
    </div>

    <button type="submit" class="btn btn-primary">Guardar Cotización</button>
    <a href="@Url.Action("Lista", "Cotizacion")" class="btn btn-secondary">Cancelar</a>
}