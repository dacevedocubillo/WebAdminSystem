@model CSMMYM.Models.Pagina

@{
    ViewBag.Title = "Historia";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link rel="stylesheet" href="~/Content/bootstrap.css" />
<link rel="stylesheet" href="~/Content/css/site-user.css" />

@if (Model.titulo == "Sección desactivada")
{
    <h2>Sección desactivada</h2>
}
else
{
    <div class="container mt-4">
        <h2>@Model.titulo</h2>

        <p class="lead">
            @Html.Raw(Model.contenido)
        </p>

        <div class="row mt-4">
            <div class="col-md-6">
                <img src="~/Content/Imagenes/historia.jpg"
                     class="img-fluid rounded shadow"
                     alt="Nuestra historia" />
            </div>

            <div class="col-md-6">
                <h4>Nuestro Camino</h4>
                <p>
                    A lo largo de nuestra trayectoria hemos construido una base sólida,
                    impulsada por la confianza de nuestros clientes y el compromiso con la calidad.
                    Esta sección puede ampliarse desde la base de datos si más adelante querés
                    que todo sea completamente dinámico.
                </p>
            </div>
        </div>
    </div>
}