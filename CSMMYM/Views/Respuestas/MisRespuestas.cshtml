@model IEnumerable<CSMMYM.Models.Respuesta>

<h2 class="mb-4">
    <i class="fas fa-comments me-2 text-primary"></i> Mis respuestas
</h2>

@if (Model != null && Model.Any())
{
    <ul class="list-group shadow-sm rounded-3">
        @foreach (var r in Model.OrderByDescending(x => x.fecha))
        {
            <li class="list-group-item">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="badge bg-info text-dark">
                        <i class="fas fa-clock me-1"></i> @r.fecha.ToString("dd/MM/yyyy HH:mm")
                    </span>
                </div>
                <p class="mb-0">@r.mensaje</p>
            </li>
        }
    </ul>
}
else
{
    <p class="text-muted">No tienes respuestas todavía.</p>
}

<!-- FontAwesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">

<!-- CSS personalizado -->
<style>
    h2 {
        font-weight: 700;
        color: #343a40;
        border-bottom: 3px solid #007bff;
        display: inline-block;
        padding-bottom: 0.3rem;
    }

    .list-group {
        border-radius: 12px;
        overflow: hidden;
    }

    .list-group-item {
        border: none;
        border-bottom: 1px solid #e9ecef;
        background-color: #fdfdfd;
        transition: background-color 0.2s ease;
    }

        .list-group-item:hover {
            background-color: #f8f9fa;
        }

    .badge {
        font-size: 0.85rem;
        padding: 0.4em 0.7em;
        border-radius: 8px;
    }
</style>